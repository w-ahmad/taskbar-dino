<Project Sdk="Microsoft.NET.Sdk">

  <!-- TaskbarDino.App — the executable and composition root. The only project that references
       every layer; wires them together via DI. Produces TaskbarDino.exe (no console window). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TaskbarDino</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ApplicationIcon is added in M6 together with the tray icon asset. -->
  </PropertyGroup>

  <ItemGroup Label="Layers">
    <ProjectReference Include="..\TaskbarDino.Core\TaskbarDino.Core.csproj" />
    <ProjectReference Include="..\TaskbarDino.Animation\TaskbarDino.Animation.csproj" />
    <ProjectReference Include="..\TaskbarDino.Game\TaskbarDino.Game.csproj" />
    <ProjectReference Include="..\TaskbarDino.Rendering\TaskbarDino.Rendering.csproj" />
    <ProjectReference Include="..\TaskbarDino.Windows\TaskbarDino.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Label="DI &amp; logging">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
