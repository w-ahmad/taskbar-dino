<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TaskbarDino.Core — everything that is pure logic: primitives, sprite/animation model, the dino's
    behaviour (brain + movement), the runner game, settings model and the built-in pixel art.
    Targets plain net10.0 and references nothing, so it physically cannot depend on Windows APIs,
    which is what keeps it unit-testable on any machine.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TaskbarDino.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
