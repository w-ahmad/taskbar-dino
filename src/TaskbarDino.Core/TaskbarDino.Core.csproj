<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TaskbarDino.Core — shared models, enums, interfaces, math and the event bus.
    Deliberately targets plain net10.0 (NOT -windows) and references nothing:
    this makes it physically impossible for the domain to depend on Windows APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Abstractions only: Core can accept an ILogger without taking a dependency on any concrete
         logging implementation, keeping the domain free of infrastructure. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
