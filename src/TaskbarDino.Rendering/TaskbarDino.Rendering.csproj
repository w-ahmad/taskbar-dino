<Project Sdk="Microsoft.NET.Sdk">

  <!-- TaskbarDino.Rendering — DirectComposition transparent overlay + Direct2D sprite rendering
       via Vortice.Windows. Implements Core's IRenderer; contains zero game logic. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarDino.Core\TaskbarDino.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.DirectComposition" />
  </ItemGroup>

</Project>
