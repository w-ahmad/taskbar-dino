<Project Sdk="Microsoft.NET.Sdk">

  <!-- TaskbarDino.Windows — all Win32 integration: overlay window, foreground/taskbar/monitor
       tracking, tray icon, startup. P/Invoke is source-generated by CsWin32 (see NativeMethods.txt).
       Implements Core interfaces; isolated so the rest of the app never sees a raw Win32 call. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Concrete arch is required for CsWin32 to emit pointer-width-specific APIs
         (Get/SetWindowLongPtr, SHAppBarMessage, MsgWaitForMultipleObjectsEx). Ship is win-x64 only.
         The unversioned windows TFM is used deliberately to avoid pulling the large WinRT projection. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarDino.Core\TaskbarDino.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
