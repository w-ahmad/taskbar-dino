<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TaskbarDino — the executable. Win32 integration (overlay window, hooks, taskbar/UIA, tray),
    the Direct2D/DirectComposition renderer and the companion/game orchestration. All interop is
    source-generated by CsWin32 from Win32/NativeMethods.txt with marshaling disabled, so the app
    has no runtime NuGet dependencies and publishes as a single Native AOT executable.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TaskbarDino</RootNamespace>
    <AssemblyName>TaskbarDino</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TaskbarDino.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Release deployment: a single native executable (no runtime install), trimmed and size-tuned. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <!-- The companion never allocates enough to need a server/concurrent GC; workstation non-concurrent is smallest. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarDino.Core\TaskbarDino.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Win32\NativeMethods.txt" />
    <AdditionalFiles Include="Win32\NativeMethods.json" />
  </ItemGroup>

</Project>
